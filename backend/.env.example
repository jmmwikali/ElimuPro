SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://elimupro:change-me@localhost:5432/elimupro
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_HOURS=12

# Cyzora Pay: from the Cyzora dashboard (API keys + Webhooks).
# Use sk_test_ keys until the business is verified for live payments.
# Leave empty to keep online payments switched off. Never commit real values.
CYZORA_SECRET_KEY=
CYZORA_WEBHOOK_SECRET=
# Optional: override the API base (defaults to https://api.cyzora.co.ke/api/v1)
# CYZORA_BASE_URL=https://api.cyzora.co.ke/api/v1
# CYZORA_TIMEOUT=20
# CYZORA_RETRY_DELAY=1

# ZeroQ student documents are kept in a PRIVATE folder, never served directly.
# On a host with a temporary disk, point this at a persistent volume (or move storage to private object storage).
ZEROQ_UPLOAD_DIR=
ZEROQ_MAX_UPLOAD_MB=10
